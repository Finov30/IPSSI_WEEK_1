# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# HDFS Configuration
HDFS_HOST=localhost
HDFS_PORT=9000
HDFS_PATH=/sirene_data

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=sirene-dataviz

# Data Paths
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
DATA_AGGREGATED_PATH=./data/aggregated
DATASET_CSV_PATH=./dataset/Sirene_merged_with_region.csv

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
